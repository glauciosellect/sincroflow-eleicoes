generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

// ─── Autenticação (equipe + candidato fazem login aqui) ──────────────────────

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String?
  phone            String?
  avatarUrl        String?
  googleId         String?           @unique
  language         String            @default("pt-br")
  theme            String            @default("light")
  twoFactorSecret  String?
  twoFactorEnabled Boolean           @default(false)
  onboardingDone   Boolean           @default(false)
  onboardingData   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  apiKeys          ApiKey[]
  sessions         Session[]
  teamMemberships  TeamMember[]
  termsAcceptances TermsAcceptance[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  userId      String
  candidateId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Candidato (tenant principal — substitui Workspace) ──────────────────────

model Candidate {
  id                   String          @id @default(cuid())
  name                 String
  cpf                  String          @unique
  email                String          @unique
  whatsapp             String
  candidateNumber      String?
  party                String?
  position             String?
  state                String?
  city                 String?
  photoUrl             String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               CandidateStatus @default(ACTIVE)
  plan                 CandidatePlan   @default(CAMPAIGN)
  activeMsgsIncluded   Int             @default(1000)
  activeMsgsUsed       Int             @default(0)
  activeMsgsExtra      Int             @default(0)
  activeMsgsResetAt    DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  teamMembers      TeamMember[]
  agentConfig      AgentConfig?
  platformTopics   PlatformTopic[]
  channels         Channel[]
  contacts         Contact[]
  conversations    Conversation[]
  requests         Request[]
  events           Event[]
  auditLogs        AuditLog[]
  termsAcceptances TermsAcceptance[]
  apiKeys          ApiKey[]
  envVariables     EnvVariable[]
  invoices         Invoice[]
}

model TeamMember {
  id          String           @id @default(cuid())
  candidateId String
  userId      String?
  name        String
  email       String
  role        TeamRole         @default(ATENDIMENTO)
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  status      TeamMemberStatus @default(PENDING)
  inviteToken String?          @unique
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([candidateId, email])
}

// ─── Cadastro do agente (Minha História, Disclaimer, Plataforma Eleitoral) ───

model AgentConfig {
  id                    String     @id @default(cuid())
  candidateId           String     @unique
  agentName             String     @default("Assistente da Campanha")
  agentRole             String     @default("Assistente virtual de atendimento eleitoral")
  agentStyle            AgentStyle @default(ACOLHEDOR)
  story                 String?    @db.Text
  disclaimer            String     @db.Text
  candidateSite         String?
  voiceEnabled          Boolean    @default(false)
  ttsVoice              String?    @default("onyx")
  responseDelay         Int        @default(0)
  language              String     @default("pt-br")
  timezone              String     @default("America/Sao_Paulo")
  isActive              Boolean    @default(false)
  deactivatedAt         DateTime?
  deactivationReason    String?
  googleCalendarEnabled Boolean    @default(false)
  googleCalendarEmail   String?
  googleCalendarId      String?
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt
  candidate             Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model PlatformTopic {
  id          String    @id @default(cuid())
  candidateId String
  topicKey    String
  topicName   String
  content     String?   @db.Text
  updatedAt   DateTime  @default(now()) @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, topicKey])
}

// ─── Canais de atendimento (1 por tipo por candidato) ────────────────────────

model Channel {
  id            String         @id @default(cuid())
  candidateId   String
  type          ChannelType
  name          String
  isActive      Boolean        @default(true)
  config        Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  conversations Conversation[]

  @@unique([candidateId, type])
}

// ─── Contatos (eleitores) e memória de conversa ──────────────────────────────

model Contact {
  id                String         @id @default(cuid())
  candidateId       String
  channelId         String
  externalId        String
  name              String?
  phone             String?
  email             String?
  firstContactAt    DateTime       @default(now())
  lastContactAt     DateTime       @default(now())
  totalInteractions Int            @default(0)
  notes             String?
  audioPreference   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  channel           Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  requests          Request[]

  @@unique([candidateId, channelId, externalId])
}

model Conversation {
  id            String             @id @default(cuid())
  candidateId   String
  contactId     String
  channelId     String
  status        ConversationStatus @default(ACTIVE)
  assignedToId  String?
  startedAt     DateTime           @default(now())
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  candidate     Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages      Message[]
  requests      Request[]
}

model Message {
  id              String            @id @default(cuid())
  conversationId  String
  senderType      MessageSenderType
  content         String            @db.Text
  mediaUrl        String?
  mediaType       String?
  audioTranscript String?           @db.Text
  isRead          Boolean           @default(false)
  isActiveMessage Boolean           @default(false)
  createdAt       DateTime          @default(now())
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ─── Solicitações e protocolos ───────────────────────────────────────────────

model Request {
  id             String        @id @default(cuid())
  candidateId    String
  contactId      String
  conversationId String?
  protocolNumber String        @unique
  subject        String
  description    String?       @db.Text
  region         String?
  neighborhood   String?
  status         RequestStatus @default(RECEIVED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  resolvedBy     String?
  resolvedAt     DateTime?
  candidate      Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
}

// ─── Agenda ───────────────────────────────────────────────────────────────────

model Event {
  id            String    @id @default(cuid())
  candidateId   String
  title         String
  description   String?   @db.Text
  eventType     EventType @default(PRESENCIAL)
  location      String?
  neighborhood  String?
  city          String?
  link          String?
  startsAt      DateTime
  endsAt        DateTime?
  isPublic      Boolean   @default(true)
  googleEventId String?   @unique
  createdAt     DateTime  @default(now())
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Compliance / auditoria ───────────────────────────────────────────────────

model AuditLog {
  id             String    @id @default(cuid())
  candidateId    String
  conversationId String?
  messageId      String?
  eventType      String
  content        String?   @db.Text
  metadata       Json?
  createdAt      DateTime  @default(now())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model TermsAcceptance {
  id          String    @id @default(cuid())
  candidateId String
  userId      String
  version     String
  ipAddress   String?
  userAgent   String?
  acceptedAt  DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String    @id @default(cuid())
  candidateId String
  amount      Int
  status      String
  externalId  String?
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}

model EnvVariable {
  id          String     @id @default(cuid())
  candidateId String
  key         String
  value       String
  type        EnvVarType @default(TEXT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, key])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum CandidateStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CandidatePlan {
  CAMPAIGN
  MANDATE
}

enum TeamRole {
  ADMINISTRADOR
  ATENDIMENTO
  CONTEUDO
  RELATORIOS
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum AgentStyle {
  FORMAL
  INFORMAL
  ACOLHEDOR
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  EMAIL
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  URGENT
}

enum MessageSenderType {
  VOTER
  AGENT
  HUMAN
}

enum RequestStatus {
  RECEIVED
  ANALYZING
  FORWARDED
  RESOLVED
}

enum EventType {
  PRESENCIAL
  ONLINE
  LIVE
  DEBATE
  REUNIAO
}

enum EnvVarType {
  TEXT
  NUMBER
}
