generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

// ─── Autenticação (equipe + candidato fazem login aqui) ──────────────────────

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String?
  phone            String?
  avatarUrl        String?
  googleId         String?           @unique
  language         String            @default("pt-br")
  theme            String            @default("light")
  twoFactorSecret  String?
  twoFactorEnabled Boolean           @default(false)
  onboardingDone   Boolean           @default(false)
  onboardingData   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  apiKeys          ApiKey[]
  sessions         Session[]
  teamMemberships  TeamMember[]
  termsAcceptances TermsAcceptance[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  userId      String
  candidateId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Candidato (tenant principal — substitui Workspace) ──────────────────────

model Candidate {
  id                   String          @id @default(cuid())
  name                 String
  cpf                  String          @unique
  email                String          @unique
  whatsapp             String
  candidateNumber      String?
  party                String?
  position             String?
  state                String?
  city                 String?
  photoUrl             String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               CandidateStatus @default(ACTIVE)
  plan                 CandidatePlan   @default(CAMPAIGN)
  // Limite de números de WhatsApp simultâneos permitidos pelo tier de billing
  // (Starter=1, Pro=3, Business=10, Enterprise=-1 "ilimitado"). Independente
  // de `plan`, que representa a FASE da campanha (CAMPAIGN/MANDATE), não o volume.
  whatsappLineLimit    Int             @default(1)
  // Linhas extras aprovadas manualmente (Pix, painel /admin) — somadas à fórmula
  // de syncWhatsAppLineLimit, que senão sobrescreveria isso a cada webhook do Stripe.
  whatsappLinesManual  Int             @default(0)
  activeMsgsIncluded   Int             @default(1000)
  activeMsgsUsed       Int             @default(0)
  activeMsgsExtra      Int             @default(0)
  activeMsgsResetAt    DateTime?
  // Preenchido quando o candidato solicita cancelamento pelo painel (seguem ativos
  // até o fim do período já pago — Stripe cancel_at_period_end). status só muda
  // para CANCELLED de fato quando o webhook customer.subscription.deleted chegar.
  cancellationReason   String?
  cancellationRequestedAt DateTime?
  // Resumo automático da semana anterior (volume, temas em alta, solicitações
  // pendentes, gaps de conteúdo) — seção 4.9 da spec. Ativado por padrão.
  weeklyBriefingEnabled Boolean        @default(true)
  // Pix/boleto: pagamento único mensal manual, só permitido em plan=CAMPAIGN
  // (Mandato exige cartão/Subscription recorrente). null para quem sempre
  // pagou via cartão. Vencido sem renovação → campaign-payment.worker.ts
  // suspende automaticamente (ver compliance.worker.ts, mesmo padrão).
  campaignPaymentMethod String?
  campaignPaidUntil    DateTime?
  // Asaas — pagamento campanha eleitoral
  asaasCustomerId      String?
  asaasPaymentId       String?
  asaasPlano           String?
  // true quando o pagamento da "Ativação da Campanha" é confirmado (via webhook Asaas).
  // Separado de `status` porque status=ACTIVE já é setado na criação da conta (para o
  // atendimento por IA funcionar desde o cadastro) — este campo é o gatilho real de
  // desbloqueio dos módulos pagos (Módulo 8 da SPEC-Escala-Webhooks).
  campaignActivated   Boolean          @default(false)
  // Endereço do candidato — obrigatório para prestação de contas TSE (SPCE)
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cep                  String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  teamMembers      TeamMember[]
  agentConfig      AgentConfig?
  platformTopics   PlatformTopic[]
  channels         Channel[]
  contacts         Contact[]
  conversations    Conversation[]
  requests         Request[]
  events           Event[]
  auditLogs        AuditLog[]
  termsAcceptances TermsAcceptance[]
  apiKeys          ApiKey[]
  envVariables     EnvVariable[]
  invoices         Invoice[]
  creatives        Creative[]
  broadcasts       Broadcast[]
  voteSurveys      VoteSurveyResponse[]
  factChecks       FactCheck[]
  portalEleitor    PortalEleitor?
  coordenadores    Coordenador[]
  conteudos        ConteudoIA[]
  radarMonitorados     RadarMonitorado[]
  radarResultados      RadarResultado[]
  resumosRadar         ResumoRadar[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  metaOrcamento        MetaOrcamento?
  audiencias           Audiencia[]
  projetosLei          ProjetoLei[]
  protocolosAtendimento ProtocoloAtendimento[]
  colaboradoresCampanha ColaboradorCampanha[]
  pagamentosColaborador PagamentoColaborador[]
  territorios           Territorio[]
  atividadesLider       AtividadeLider[]
  metasSemanaLider      MetaSemanaLider[]
}

// Cadastro aguardando confirmação de pagamento — antes vivia só no Redis com TTL de
// 30min (suficiente para cartão, que confirma em segundos). Pix/boleto manual pode
// levar horas/dias até aprovação no painel /admin, por isso precisa ser persistente.
model PendingRegistration {
  id              String    @id @default(cuid())
  name            String
  cpf             String
  candidateNumber String?
  email           String
  whatsapp        String
  passwordHash    String
  paymentMethod   String // 'pix' | 'boleto' | 'card'
  plan            String    @default("CAMPAIGN")
  status          String    @default("PENDING") // PENDING | APPROVED | EXPIRED
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status])
}

model TeamMember {
  id          String           @id @default(cuid())
  candidateId String
  userId      String?
  name        String
  email       String
  whatsapp    String?
  role        TeamRole         @default(ATENDIMENTO)
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  status      TeamMemberStatus @default(PENDING)
  inviteToken String?          @unique
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  referredContacts   Contact[]
  voteSurveys        VoteSurveyResponse[]
  factChecks         FactCheck[]
  colaboradorVinculo ColaboradorCampanha?

  @@unique([candidateId, email])
}

// ─── Cadastro do agente (Minha História, Disclaimer, Plataforma Eleitoral) ───

model AgentConfig {
  id                    String     @id @default(cuid())
  candidateId           String     @unique
  agentName             String     @default("Assistente da Campanha")
  agentRole             String     @default("Assistente virtual de atendimento eleitoral")
  agentStyle            AgentStyle @default(ACOLHEDOR)
  story                 String?    @db.Text
  disclaimer            String     @db.Text
  candidateSite         String?
  // Texto extraído do site do candidato (scraping), usado como fonte de conhecimento
  // adicional no prompt da IA — evita raspar o site a cada mensagem recebida.
  siteContent           String?    @db.Text
  siteContentUpdatedAt  DateTime?
  voiceEnabled          Boolean    @default(false)
  ttsVoice              String?    @default("onyx")
  responseDelay         Int        @default(0)
  language              String     @default("pt-br")
  timezone              String     @default("America/Sao_Paulo")
  isActive              Boolean    @default(false)
  deactivatedAt         DateTime?
  deactivationReason    String?
  googleCalendarEnabled Boolean    @default(false)
  googleCalendarEmail   String?
  googleCalendarId      String?
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  pixKey                String?    // Chave Pix do candidato para receber doações eleitorais
  elevenLabsVoiceId     String?    // ID da voz clonada no ElevenLabs (futuro)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt
  candidate             Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model PlatformTopic {
  id          String    @id @default(cuid())
  candidateId String
  topicKey    String
  topicName   String
  content     String?   @db.Text
  updatedAt   DateTime  @default(now()) @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, topicKey])
}

// Biblioteca de criativos ("Santinho") — o agente anexa automaticamente ao
// responder perguntas sobre o tema vinculado, a equipe também pode anexar
// manualmente no chat, ou disparar em massa controlada (ver model Broadcast).
model Creative {
  id          String      @id @default(cuid())
  candidateId String
  title       String
  topicKey    String?
  fileUrl     String
  fileType    String
  createdAt   DateTime    @default(now())
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  broadcasts  Broadcast[]

  @@index([candidateId, topicKey])
}

// Disparo segmentado controlado de um criativo para um grupo de contatos.
// Cada envio consome 1 mensagem ativa (mesma cota do disclaimer) e é limitado
// por teto de contatos e por limite de 24h por linha de WhatsApp, para reduzir
// risco de bloqueio do número pela Meta e de disparo de propaganda não solicitada.
model Broadcast {
  id           String               @id @default(cuid())
  candidateId  String
  creativeId   String
  channelId    String
  contactType  ContactType?
  totalTargets Int
  sentCount    Int                  @default(0)
  failedCount  Int                  @default(0)
  status       BroadcastStatus      @default(QUEUED)
  createdById  String
  createdAt    DateTime             @default(now())
  completedAt  DateTime?
  candidate    Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  creative     Creative             @relation(fields: [creativeId], references: [id])
  channel      Channel              @relation(fields: [channelId], references: [id])
  recipients   BroadcastRecipient[]
}

// Um registro por contato que efetivamente recebeu — usado para aviso de
// possível duplicidade (não bloqueia reenvio) e para contar o limite de 24h por linha.
model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  contactId   String
  sentAt      DateTime  @default(now())
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// ─── Canais de atendimento ────────────────────────────────────────────────────
// WhatsApp permite múltiplos números por candidato, até o limite do plano
// (Candidate.whatsappLineLimit) — todos atendidos pelo mesmo AgentConfig.
// Instagram/Facebook/Telegram/E-mail continuam limitados a 1 por tipo
// (regra de negócio aplicada em código, ver channels.routes.ts e meta.routes.ts).

model Channel {
  id            String         @id @default(cuid())
  candidateId   String
  type          ChannelType
  name          String
  isActive      Boolean        @default(true)
  config        Json
  externalId    String?        // phoneNumberId (WhatsApp) | pageId (Facebook) | igAccountId (Instagram) | botId (Telegram)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  conversations Conversation[]
  broadcasts    Broadcast[]

  @@index([candidateId, type])
  @@unique([type, externalId])
}

// ─── Contatos (eleitores) e memória de conversa ──────────────────────────────

model Contact {
  id                String         @id @default(cuid())
  candidateId       String
  channelId         String
  externalId        String
  name              String?
  phone             String?
  email             String?
  firstContactAt    DateTime       @default(now())
  lastContactAt     DateTime       @default(now())
  totalInteractions Int            @default(0)
  notes             String?
  audioPreference   String?
  // Bairro/região mencionado pelo eleitor (extraído pela IA ao registrar uma
  // solicitação, ou preenchido manualmente pela equipe) — usado pelo relatório
  // de Solicitações por Região.
  neighborhood      String?
  // Classifica quem é o contato — todo contato nasce VOTER (a maioria de quem
  // escreve é eleitor mesmo); reclassificado manualmente pela equipe quando não é.
  contactType       ContactType    @default(VOTER)
  // Agente de Campo que captou este eleitor — detectado pela IA quando o eleitor
  // menciona o nome do agente na primeira mensagem (ex: "conheci a Milena"). Nunca
  // preenchido manualmente, sempre a mensagem espontânea do próprio eleitor.
  referredByTeamMemberId String?
  referredByTeamMember   TeamMember?  @relation(fields: [referredByTeamMemberId], references: [id], onDelete: SetNull)
  // Eleitor respondeu SAIR/STOP/PARAR — para de receber re-engajamento e criativos
  // em broadcast, mas continua podendo escrever normalmente (mensagem do eleitor
  // sempre é respondida; opt-out só bloqueia mensagens ATIVAS do agente).
  optedOutAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  candidate         Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  channel           Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  requests          Request[]
  cadastrosPortal   CadastroPortal[]

  @@unique([candidateId, channelId, externalId])
  @@index([candidateId, createdAt])
  @@index([candidateId, phone])
  @@index([candidateId, referredByTeamMemberId])
}

model Conversation {
  id            String             @id @default(cuid())
  candidateId   String
  contactId     String
  channelId     String
  status        ConversationStatus @default(ACTIVE)
  assignedToId  String?
  startedAt     DateTime           @default(now())
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  candidate     Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages      Message[]
  requests      Request[]

  @@index([candidateId, createdAt])
}

model Message {
  id              String            @id @default(cuid())
  conversationId  String
  senderType      MessageSenderType
  content         String            @db.Text
  mediaUrl        String?
  mediaType       String?
  audioTranscript String?           @db.Text
  isRead          Boolean           @default(false)
  isActiveMessage Boolean           @default(false)
  // Tema da Plataforma Eleitoral identificado nesta mensagem do eleitor (null se não
  // se encaixar em nenhum tema, ou se for mensagem do agente/humano) — usado pelos
  // alertas de pico por tema e pelo relatório "Temas Mais Perguntados".
  topicKey        String?
  // true quando a mensagem é uma pergunta sobre um tema que o candidato não cadastrou
  // conteúdo (gap de conteúdo, seção 4.13 da spec).
  isContentGap    Boolean           @default(false)
  // Sentimento da mensagem do eleitor (POSITIVE/NEUTRAL/NEGATIVE), classificado pela
  // IA na mesma chamada de classifyMessageForAlerts — usado pelo relatório de
  // Sentimento dos Eleitores, sem custo extra de IA.
  sentiment       String?
  createdAt       DateTime          @default(now())
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderType, createdAt])
}

// ─── Solicitações e protocolos ───────────────────────────────────────────────

model Request {
  id             String        @id @default(cuid())
  candidateId    String
  contactId      String
  conversationId String?
  protocolNumber String        @unique
  subject        String
  description    String?       @db.Text
  region         String?
  neighborhood   String?
  status         RequestStatus @default(RECEIVED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  resolvedBy     String?
  resolvedAt     DateTime?
  candidate      Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
}

// ─── Agenda ───────────────────────────────────────────────────────────────────

model Event {
  id            String    @id @default(cuid())
  candidateId   String
  title         String
  description   String?   @db.Text
  eventType     EventType @default(PRESENCIAL)
  location      String?
  neighborhood  String?
  city          String?
  link          String?
  startsAt      DateTime
  endsAt        DateTime?
  isPublic      Boolean   @default(true)
  googleEventId String?   @unique
  createdAt     DateTime  @default(now())
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Compliance / auditoria ───────────────────────────────────────────────────

model AuditLog {
  id             String    @id @default(cuid())
  candidateId    String
  conversationId String?
  messageId      String?
  eventType      String
  content        String?   @db.Text
  metadata       Json?
  createdAt      DateTime  @default(now())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model TermsAcceptance {
  id          String    @id @default(cuid())
  candidateId String
  userId      String
  version     String
  ipAddress   String?
  userAgent   String?
  acceptedAt  DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String    @id @default(cuid())
  candidateId  String
  amount       Int
  status       String
  externalId   String?
  provider     String    @default("stripe")
  description  String?
  installments Int       @default(1)
  createdAt    DateTime  @default(now())
  candidate    Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
}

// Configuração global do sistema — linha única (id fixo "global"), editável
// apenas por administradores do sistema (não por candidatos). Guarda as datas
// de cada turno eleitoral para o cron de desativação TSE (seção 7 da spec).
model SystemConfig {
  id                 String    @id @default("global")
  electionRound1Date DateTime?
  electionRound2Date DateTime?
  updatedAt          DateTime  @default(now()) @updatedAt
}

model EnvVariable {
  id          String     @id @default(cuid())
  candidateId String
  key         String
  value       String
  type        EnvVarType @default(TEXT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, key])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum CandidateStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CandidatePlan {
  CAMPAIGN
  MANDATE
}

enum TeamRole {
  ADMINISTRADOR
  ATENDIMENTO
  CONTEUDO
  RELATORIOS
  AGENTE_CAMPO
  COORDENADOR
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum AgentStyle {
  FORMAL
  INFORMAL
  ACOLHEDOR
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  EMAIL
  PORTAL
  CAMPO
}

enum ContactType {
  VOTER
  FAMILY_FRIEND
  STAFF
  CONTRACTOR
  OTHER
}

enum BroadcastStatus {
  QUEUED
  SENDING
  COMPLETED
  COMPLETED_WITH_ERRORS
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  URGENT
}

enum MessageSenderType {
  VOTER
  AGENT
  HUMAN
}

enum RequestStatus {
  RECEIVED
  ANALYZING
  FORWARDED
  RESOLVED
}

enum EventType {
  PRESENCIAL
  ONLINE
  LIVE
  DEBATE
  REUNIAO
}

enum EnvVarType {
  TEXT
  NUMBER
}

enum VoteIntention {
  APOIADOR   // vai votar com certeza
  INDECISO   // ainda não decidiu
  CRITICO    // não vai votar / crítico
}

// Consulta de fatos — agente cola boato/dúvida, IA analisa e responde com fontes
model FactCheck {
  id            String   @id @default(cuid())
  candidateId   String
  checkedById   String?
  query         String   // texto da dúvida/boato enviado pelo agente
  verdict       String   // VERDADEIRO | FALSO | PARCIALMENTE_VERDADEIRO | INCONCLUSIVO
  analysis      String   // análise em texto
  suggestedReply String  // rascunho de resposta para o agente usar
  sources       String[] // fontes citadas
  savedToLibrary Boolean @default(false)
  tags          String[]
  createdAt     DateTime @default(now())

  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  checkedBy   TeamMember? @relation(fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([candidateId, verdict])
}

// Pesquisa de intenção de voto coletada pelos agentes de campo
model VoteSurveyResponse {
  id                    String        @id @default(cuid())
  candidateId           String
  collectedById         String?
  voterName             String?
  voterPhone            String?
  cep                   String?
  neighborhood          String?
  city                  String?
  state                 String? // UF (ex: "MG") — vem do ViaCEP, usado no Mapa de Apoiadores para agregação estadual
  intention             VoteIntention
  notes                 String?
  // Intenção por cargo — texto livre para flexibilidade durante a campanha
  prefVereador          String?
  prefDepEstadual       String?
  prefDepFederal        String?
  prefSenador           String?
  prefGovernador        String?
  prefPresidente        String?
  createdAt             DateTime      @default(now())

  candidate       Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  collectedBy     TeamMember?   @relation(fields: [collectedById], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([candidateId, intention])
  @@index([candidateId, collectedById])
}

// ─── Portal do Eleitor — M1 ───────────────────────────────────────────────────

model PortalEleitor {
  id             String   @id @default(cuid())
  candidateId    String   @unique
  slug           String   @unique
  titulo         String
  subtitulo      String?
  descricao      String?  @db.Text
  fotoUrl        String?
  fotoSobre      String?
  fotoFundo      String?  // imagem de fundo do hero — substitui o gradiente de corPrimaria quando preenchida
  corPrimaria    String   @default("#002776")
  corDestaque    String   @default("#C9A227")
  corTexto       String   @default("#FFFFFF") // cor do texto/títulos do hero — separada de corPrimaria (fundo)
  numero         String?
  instagram      String?
  facebook       String?
  tiktok         String?
  whatsapp       String?
  trajetoria     Json?
  depoimentos    Json?
  ativo          Boolean  @default(true)
  totalCadastros Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidate Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cadastros CadastroPortal[]

  @@index([slug])
}

model CadastroPortal {
  id       String        @id @default(cuid())
  portalId String
  nome     String
  telefone String
  email    String?
  cidade   String?
  bairro   String?
  assunto  String?
  mensagem String?       @db.Text
  status    String        @default("novo")
  origemIp  String?
  contactId String?       // preenchido ao sincronizar com Contatos
  createdAt DateTime      @default(now())

  portal  PortalEleitor @relation(fields: [portalId], references: [id], onDelete: Cascade)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([portalId, status])
  @@index([portalId, createdAt])
}

// ─── Área do Coordenador — M2 ─────────────────────────────────────────────────

model Coordenador {
  id             String    @id @default(cuid())
  candidateId    String
  nome           String
  telefone       String?
  email          String    @unique
  senhaHash      String
  cidade         String?
  bairros        String[]
  metaVotos      Int?
  ativo          Boolean   @default(true)
  ultimoAcesso   DateTime?
  colaboradorId  String?   // vínculo com ColaboradorCampanha para ver subordinados
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidate  Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  checkIns   CheckInLider[]

  @@index([candidateId, ativo])
  @@index([colaboradorId])
}

model CheckInLider {
  id             String      @id @default(cuid())
  liderId        String
  coordenadorId  String
  candidateId    String
  tipo           String
  observacao     String?
  dataCheckin    DateTime    @default(now())
  createdAt      DateTime    @default(now())

  coordenador Coordenador @relation(fields: [coordenadorId], references: [id], onDelete: Cascade)

  @@index([coordenadorId])
  @@index([candidateId, dataCheckin])
}

// ─── Criação de Conteúdo com IA — M4 ─────────────────────────────────────────

model ConteudoIA {
  id              String   @id @default(cuid())
  candidateId     String
  tema            String
  temaCustomizado String?
  plataforma      String
  tom             String   @default("proximo")
  textoGerado     String   @db.Text
  hashtags        String[]
  status          String   @default("rascunho")
  agendadoPara    DateTime?
  enviadoEm       DateTime?
  canalEnvio      String?
  tokensUsados    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@index([candidateId, createdAt])
}

// ─── Radar Político + Social — M5 ────────────────────────────────────────────

model RadarMonitorado {
  id            String   @id @default(cuid())
  candidateId   String
  tipo          String
  nome          String
  rssUrl        String?
  twitterQuery  String?
  plataformas   String[]
  ativo         Boolean  @default(true)
  ultimaColeta  DateTime?
  createdAt     DateTime @default(now())

  candidate  Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resultados RadarResultado[]

  @@index([candidateId, ativo])
}

model RadarResultado {
  id            String          @id @default(cuid())
  radarId       String
  candidateId   String
  plataforma    String
  tipo          String
  titulo        String?
  texto         String          @db.Text
  url           String?
  autor         String?
  engajamento   Int?
  sentimento    String?
  relevancia    Int             @default(0)
  lido          Boolean         @default(false)
  alertaGerado  Boolean         @default(false)
  sugestaoIA    String?         @db.Text
  coletadoEm   DateTime        @default(now())

  radar     RadarMonitorado @relation(fields: [radarId], references: [id], onDelete: Cascade)
  candidate Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([radarId, lido])
  @@index([candidateId, relevancia])
  @@index([coletadoEm])
}

model ResumoRadar {
  id               String   @id @default(cuid())
  candidateId      String
  periodoInicio    DateTime
  periodoFim       DateTime
  tipo             String
  resumoTexto      String   @db.Text
  principaisAlertas Json
  sugestaoAcao     String?  @db.Text
  enviado          Boolean  @default(false)
  createdAt        DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, tipo])
}

// ─── Controle Financeiro de Campanha — M6 ────────────────────────────────────

model LancamentoFinanceiro {
  id           String   @id @default(cuid())
  candidateId  String
  tipo         String   // 'receita' | 'despesa'
  categoria    String
  descricao    String
  valor        Decimal  @db.Decimal(12, 2)
  data         DateTime
  fornecedor   String?
  doadorCpf    String?  // CPF obrigatório para doação de pessoa física (TSE)
  notaFiscal   String?
  comprovante  String?
  observacao   String?  @db.Text
  status       String   @default("confirmado") // 'confirmado' | 'pendente' | 'cancelado'
  tseCategoria String?  // código de categoria TSE para prestação de contas
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, tipo])
  @@index([candidateId, data])
  @@index([candidateId, categoria])
}

model MetaOrcamento {
  id          String   @id @default(cuid())
  candidateId String   @unique
  totalPrevisto Decimal @db.Decimal(12, 2) @default(0)
  alertaPercentual Int  @default(80) // alerta quando gastar X% do orçamento
  checklistPrestacao Int[] @default([]) // IDs das etapas concluídas pelo candidato
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Equipe de Campanha — M8 ─────────────────────────────────────────────────

model ColaboradorCampanha {
  id             String   @id @default(cuid())
  candidateId    String
  nome           String
  cpf            String?
  funcao         String   // cabo_eleitoral | coordenador | motorista | assessor | mesario | outro
  funcaoCustom   String?
  telefone       String?
  email          String?
  dataInicio     DateTime
  dataFim        DateTime?
  valorAcordado  Decimal  @db.Decimal(12, 2)
  periodicidade  String   @default("mensal")
  formaPagamento String   @default("pix")
  observacao     String?  @db.Text
  status         String   @default("ativo")
  // Hierarquia: aponta para o superior direto (Coordenador → Supervisor → Agente)
  supervisorId   String?
  // Vínculo com TeamMember quando o colaborador tem acesso ao SyncroFlow
  teamMemberId   String?  @unique
  // Gestor de Líderes: territórios e metas
  bairros        String[] @default([])  // bairros/territórios de atuação
  metaVotos      Int?                   // meta de votos comprometidos
  // Score de atividade calculado semanalmente (pesquisas + check-ins + tarefas)
  scoreAtividade Int      @default(0)
  // Total de votos comprometidos coletados via pesquisa
  votosComprometidos Int  @default(0)
  // Índice de confiabilidade 0-100 (metas cumpridas / total de períodos)
  confiabilidade Int      @default(100)
  // Última atividade registrada
  ultimaAtividade DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidate    Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  teamMember   TeamMember?             @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  supervisor   ColaboradorCampanha?    @relation("Hierarquia", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinados ColaboradorCampanha[]   @relation("Hierarquia")
  pagamentos   PagamentoColaborador[]
  atividades   AtividadeLider[]
  metasSemana  MetaSemanaLider[]

  @@index([candidateId, status])
  @@index([candidateId, funcao])
  @@index([supervisorId])
  @@index([candidateId, scoreAtividade])
}

model PagamentoColaborador {
  id              String   @id @default(cuid())
  candidateId     String
  colaboradorId   String
  valor           Decimal  @db.Decimal(12, 2)
  dataPagamento   DateTime
  competencia     String?  // ex: "07/2026" — mês/ano de referência
  formaPagamento  String   @default("pix")
  comprovante     String?  // URL do comprovante (futuro: Supabase Storage)
  observacao      String?
  lancamentoId    String?  // vínculo com LancamentoFinanceiro gerado automaticamente
  createdAt       DateTime @default(now())

  candidate    Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  colaborador  ColaboradorCampanha  @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([candidateId, dataPagamento])
  @@index([colaboradorId])
}

// ─── Gestor de Líderes — M9 ──────────────────────────────────────────────────

// Log de atividades individuais do líder — cada ação registrada gera pontuação
model AtividadeLider {
  id            String   @id @default(cuid())
  candidateId   String
  colaboradorId String
  tipo          String   // pesquisa_voto | check_in | evento | tarefa | contato | outro
  descricao     String?
  pontos        Int      @default(1) // peso da atividade no score semanal
  bairro        String?
  dataAtividade DateTime @default(now())
  createdAt     DateTime @default(now())

  colaborador ColaboradorCampanha @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  candidate   Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, dataAtividade])
  @@index([candidateId, tipo])
  @@index([candidateId, dataAtividade])
}


// Metas semanais por líder — admin/coordenador define, sistema monitora
model MetaSemanaLider {
  id            String   @id @default(cuid())
  candidateId   String
  colaboradorId String
  semanaInicio  DateTime // segunda-feira da semana
  metaPesquisas Int      @default(0)
  metaCheckIns  Int      @default(0)
  metaEventos   Int      @default(0)
  metaContatos  Int      @default(0)
  realPesquisas Int      @default(0)
  realCheckIns  Int      @default(0)
  realEventos   Int      @default(0)
  realContatos  Int      @default(0)
  fechada       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  colaborador ColaboradorCampanha @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  candidate   Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, semanaInicio])
  @@index([candidateId, semanaInicio])
}

// Território / zona eleitoral com líder responsável e meta de votos
model Territorio {
  id            String   @id @default(cuid())
  candidateId   String
  nome          String   // ex: "Centro", "Bairro Novo", "Zona Sul Setor 3"
  bairros       String[] // lista de bairros que compõem este território
  metaVotos     Int      @default(0)
  responsavelId String?  // ColaboradorCampanha.id do líder responsável
  observacao    String?  @db.Text
  cor           String?  // cor hex para visualização no mapa
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, ativo])
}

// ─── Gabinete 360 — M7 ───────────────────────────────────────────────────────

model Audiencia {
  id           String   @id @default(cuid())
  candidateId  String
  titulo       String
  solicitante  String
  telefone     String?
  email        String?
  assunto      String
  descricao    String?  @db.Text
  dataHora     DateTime
  local        String?
  status       String   @default("agendada") // agendada | realizada | cancelada | reagendada
  prioridade   String   @default("normal")   // normal | alta | urgente
  encaminhamento String? @db.Text
  resultado    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@index([candidateId, dataHora])
}

model ProjetoLei {
  id           String   @id @default(cuid())
  candidateId  String
  numero       String?
  titulo       String
  ementa       String   @db.Text
  tipo         String   // pl | pec | requerimento | indicacao | mocao | outro
  status       String   @default("rascunho") // rascunho | protocolado | tramitando | aprovado | rejeitado | arquivado
  dataProtocolo DateTime?
  dataVotacao  DateTime?
  resultado    String?
  linkOficial  String?
  temas        String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@index([candidateId, tipo])
}

model ProtocoloAtendimento {
  id           String   @id @default(cuid())
  candidateId  String
  numero       String
  solicitante  String
  telefone     String?
  assunto      String
  descricao    String?  @db.Text
  status       String   @default("aberto") // aberto | em_andamento | resolvido | arquivado
  prioridade   String   @default("normal")
  responsavel  String?
  resposta     String?  @db.Text
  resolvidoEm  DateTime?
  prazo        DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@index([candidateId, createdAt])
}
