generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

// ─── Autenticação (equipe + candidato fazem login aqui) ──────────────────────

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String?
  phone            String?
  avatarUrl        String?
  googleId         String?           @unique
  language         String            @default("pt-br")
  theme            String            @default("light")
  twoFactorSecret  String?
  twoFactorEnabled Boolean           @default(false)
  onboardingDone   Boolean           @default(false)
  onboardingData   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  apiKeys          ApiKey[]
  sessions         Session[]
  teamMemberships  TeamMember[]
  termsAcceptances TermsAcceptance[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  userId      String
  candidateId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Candidato (tenant principal — substitui Workspace) ──────────────────────

model Candidate {
  id                   String          @id @default(cuid())
  name                 String
  cpf                  String          @unique
  email                String          @unique
  whatsapp             String
  candidateNumber      String?
  party                String?
  position             String?
  state                String?
  city                 String?
  photoUrl             String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               CandidateStatus @default(ACTIVE)
  plan                 CandidatePlan   @default(CAMPAIGN)
  // Limite de números de WhatsApp simultâneos permitidos pelo tier de billing
  // (Starter=1, Pro=3, Business=10, Enterprise=-1 "ilimitado"). Independente
  // de `plan`, que representa a FASE da campanha (CAMPAIGN/MANDATE), não o volume.
  whatsappLineLimit    Int             @default(1)
  activeMsgsIncluded   Int             @default(1000)
  activeMsgsUsed       Int             @default(0)
  activeMsgsExtra      Int             @default(0)
  activeMsgsResetAt    DateTime?
  // Preenchido quando o candidato solicita cancelamento pelo painel (seguem ativos
  // até o fim do período já pago — Stripe cancel_at_period_end). status só muda
  // para CANCELLED de fato quando o webhook customer.subscription.deleted chegar.
  cancellationReason   String?
  cancellationRequestedAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  teamMembers      TeamMember[]
  agentConfig      AgentConfig?
  platformTopics   PlatformTopic[]
  channels         Channel[]
  contacts         Contact[]
  conversations    Conversation[]
  requests         Request[]
  events           Event[]
  auditLogs        AuditLog[]
  termsAcceptances TermsAcceptance[]
  apiKeys          ApiKey[]
  envVariables     EnvVariable[]
  invoices         Invoice[]
  creatives        Creative[]
  broadcasts       Broadcast[]
}

model TeamMember {
  id          String           @id @default(cuid())
  candidateId String
  userId      String?
  name        String
  email       String
  role        TeamRole         @default(ATENDIMENTO)
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  status      TeamMemberStatus @default(PENDING)
  inviteToken String?          @unique
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([candidateId, email])
}

// ─── Cadastro do agente (Minha História, Disclaimer, Plataforma Eleitoral) ───

model AgentConfig {
  id                    String     @id @default(cuid())
  candidateId           String     @unique
  agentName             String     @default("Assistente da Campanha")
  agentRole             String     @default("Assistente virtual de atendimento eleitoral")
  agentStyle            AgentStyle @default(ACOLHEDOR)
  story                 String?    @db.Text
  disclaimer            String     @db.Text
  candidateSite         String?
  voiceEnabled          Boolean    @default(false)
  ttsVoice              String?    @default("onyx")
  responseDelay         Int        @default(0)
  language              String     @default("pt-br")
  timezone              String     @default("America/Sao_Paulo")
  isActive              Boolean    @default(false)
  deactivatedAt         DateTime?
  deactivationReason    String?
  googleCalendarEnabled Boolean    @default(false)
  googleCalendarEmail   String?
  googleCalendarId      String?
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt
  candidate             Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model PlatformTopic {
  id          String    @id @default(cuid())
  candidateId String
  topicKey    String
  topicName   String
  content     String?   @db.Text
  updatedAt   DateTime  @default(now()) @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, topicKey])
}

// Biblioteca de criativos ("Santinho") — o agente anexa automaticamente ao
// responder perguntas sobre o tema vinculado, a equipe também pode anexar
// manualmente no chat, ou disparar em massa controlada (ver model Broadcast).
model Creative {
  id          String      @id @default(cuid())
  candidateId String
  title       String
  topicKey    String?
  fileUrl     String
  fileType    String
  createdAt   DateTime    @default(now())
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  broadcasts  Broadcast[]

  @@index([candidateId, topicKey])
}

// Disparo segmentado controlado de um criativo para um grupo de contatos.
// Cada envio consome 1 mensagem ativa (mesma cota do disclaimer) e é limitado
// por teto de contatos e por limite de 24h por linha de WhatsApp, para reduzir
// risco de bloqueio do número pela Meta e de disparo de propaganda não solicitada.
model Broadcast {
  id           String               @id @default(cuid())
  candidateId  String
  creativeId   String
  channelId    String
  contactType  ContactType?
  totalTargets Int
  sentCount    Int                  @default(0)
  failedCount  Int                  @default(0)
  status       BroadcastStatus      @default(QUEUED)
  createdById  String
  createdAt    DateTime             @default(now())
  completedAt  DateTime?
  candidate    Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  creative     Creative             @relation(fields: [creativeId], references: [id])
  recipients   BroadcastRecipient[]
}

// Um registro por contato que efetivamente recebeu — usado para aviso de
// possível duplicidade (não bloqueia reenvio) e para contar o limite de 24h por linha.
model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  contactId   String
  sentAt      DateTime  @default(now())
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// ─── Canais de atendimento ────────────────────────────────────────────────────
// WhatsApp permite múltiplos números por candidato, até o limite do plano
// (Candidate.whatsappLineLimit) — todos atendidos pelo mesmo AgentConfig.
// Instagram/Facebook/Telegram/E-mail continuam limitados a 1 por tipo
// (regra de negócio aplicada em código, ver channels.routes.ts e meta.routes.ts).

model Channel {
  id            String         @id @default(cuid())
  candidateId   String
  type          ChannelType
  name          String
  isActive      Boolean        @default(true)
  config        Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  conversations Conversation[]

  @@index([candidateId, type])
}

// ─── Contatos (eleitores) e memória de conversa ──────────────────────────────

model Contact {
  id                String         @id @default(cuid())
  candidateId       String
  channelId         String
  externalId        String
  name              String?
  phone             String?
  email             String?
  firstContactAt    DateTime       @default(now())
  lastContactAt     DateTime       @default(now())
  totalInteractions Int            @default(0)
  notes             String?
  audioPreference   String?
  // Classifica quem é o contato — todo contato nasce VOTER (a maioria de quem
  // escreve é eleitor mesmo); reclassificado manualmente pela equipe quando não é.
  contactType       ContactType    @default(VOTER)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  channel           Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  requests          Request[]

  @@unique([candidateId, channelId, externalId])
  @@index([candidateId, createdAt])
  @@index([candidateId, phone])
}

model Conversation {
  id            String             @id @default(cuid())
  candidateId   String
  contactId     String
  channelId     String
  status        ConversationStatus @default(ACTIVE)
  assignedToId  String?
  startedAt     DateTime           @default(now())
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  candidate     Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages      Message[]
  requests      Request[]
}

model Message {
  id              String            @id @default(cuid())
  conversationId  String
  senderType      MessageSenderType
  content         String            @db.Text
  mediaUrl        String?
  mediaType       String?
  audioTranscript String?           @db.Text
  isRead          Boolean           @default(false)
  isActiveMessage Boolean           @default(false)
  // Tema da Plataforma Eleitoral identificado nesta mensagem do eleitor (null se não
  // se encaixar em nenhum tema, ou se for mensagem do agente/humano) — usado pelos
  // alertas de pico por tema e pelo relatório "Temas Mais Perguntados".
  topicKey        String?
  // true quando a mensagem é uma pergunta sobre um tema que o candidato não cadastrou
  // conteúdo (gap de conteúdo, seção 4.13 da spec).
  isContentGap    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ─── Solicitações e protocolos ───────────────────────────────────────────────

model Request {
  id             String        @id @default(cuid())
  candidateId    String
  contactId      String
  conversationId String?
  protocolNumber String        @unique
  subject        String
  description    String?       @db.Text
  region         String?
  neighborhood   String?
  status         RequestStatus @default(RECEIVED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  resolvedBy     String?
  resolvedAt     DateTime?
  candidate      Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
}

// ─── Agenda ───────────────────────────────────────────────────────────────────

model Event {
  id            String    @id @default(cuid())
  candidateId   String
  title         String
  description   String?   @db.Text
  eventType     EventType @default(PRESENCIAL)
  location      String?
  neighborhood  String?
  city          String?
  link          String?
  startsAt      DateTime
  endsAt        DateTime?
  isPublic      Boolean   @default(true)
  googleEventId String?   @unique
  createdAt     DateTime  @default(now())
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Compliance / auditoria ───────────────────────────────────────────────────

model AuditLog {
  id             String    @id @default(cuid())
  candidateId    String
  conversationId String?
  messageId      String?
  eventType      String
  content        String?   @db.Text
  metadata       Json?
  createdAt      DateTime  @default(now())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model TermsAcceptance {
  id          String    @id @default(cuid())
  candidateId String
  userId      String
  version     String
  ipAddress   String?
  userAgent   String?
  acceptedAt  DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String    @id @default(cuid())
  candidateId String
  amount      Int
  status      String
  externalId  String?
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}

// Configuração global do sistema — linha única (id fixo "global"), editável
// apenas por administradores do sistema (não por candidatos). Guarda as datas
// de cada turno eleitoral para o cron de desativação TSE (seção 7 da spec).
model SystemConfig {
  id                 String    @id @default("global")
  electionRound1Date DateTime?
  electionRound2Date DateTime?
  updatedAt          DateTime  @default(now()) @updatedAt
}

model EnvVariable {
  id          String     @id @default(cuid())
  candidateId String
  key         String
  value       String
  type        EnvVarType @default(TEXT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, key])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum CandidateStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CandidatePlan {
  CAMPAIGN
  MANDATE
}

enum TeamRole {
  ADMINISTRADOR
  ATENDIMENTO
  CONTEUDO
  RELATORIOS
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum AgentStyle {
  FORMAL
  INFORMAL
  ACOLHEDOR
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  EMAIL
}

enum ContactType {
  VOTER
  FAMILY_FRIEND
  STAFF
  CONTRACTOR
  OTHER
}

enum BroadcastStatus {
  QUEUED
  SENDING
  COMPLETED
  COMPLETED_WITH_ERRORS
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  URGENT
}

enum MessageSenderType {
  VOTER
  AGENT
  HUMAN
}

enum RequestStatus {
  RECEIVED
  ANALYZING
  FORWARDED
  RESOLVED
}

enum EventType {
  PRESENCIAL
  ONLINE
  LIVE
  DEBATE
  REUNIAO
}

enum EnvVarType {
  TEXT
  NUMBER
}
